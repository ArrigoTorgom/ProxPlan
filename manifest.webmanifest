{
  "id": "proxplan",
  "name": "ProxPlan",
  "short_name": "ProxPlan",
  "description": "Weekly planner for tasks, meetings, projects and time logging.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5f6",
